#!/usr/bin/env python3
"""gen-projections: render the domain-scoped index projections (M4).

Index authority (M4 option a): the BELIEF CHANNEL owns the flat MEMORY.md / MEMORY.local.md
`[]`-index lines — distill Edits them via the file tools, review-apply de-indexes them, and
quarantine tombstones them directly. This generator owns ONLY the domain projections
MEMORY.<domain>.md / MEMORY.local.<domain>.md. It:

  * renders one line per domain-tagged, NON-doctrine memory into each of its domains'
    projections — rendered from the body (title + description), so a projection line cannot
    drift from the body; a `basis: contradicted` body renders AS the tombstone line;
  * removes any domain-tagged memory's line from the flat index (a tagged memory lives in
    its projections, never the flat index) — it never touches a `[]` line or a doctrine line;
  * never projects a `doctrine: true` memory and never removes its flat line (doctrine always
    rides the always-loaded flat tier), failing loudly if a doctrine body is unparseable.

Runs under the shared store lock. Union match: a memory tagged [a, b] appears in both
MEMORY.a.md and MEMORY.b.md.

  gen-projections                  regenerate projections + slim the flat index
  gen-projections --backfill-titles  one-time migration: add `title:` to bodies that lack it,
                                   from their current flat-index title (run BEFORE the first
                                   generate — the generator refuses a projected body with no title)
  gen-projections --flatten        inverse: re-inline every projection line into the flat index
                                   and delete the projection files (the M4 rollback pre-step)
  gen-projections --check          dry-run under the store lock: exit 0 in sync, 3 out of sync,
                                   4 skipped (lock held — a generate is in flight); no writes

Domains must match [A-Za-z0-9_-] and not be 'local' (reserved for the flat personal index);
the generator refuses (exit 2) a memory with an invalid domain, an unparseable body, or a
projected body missing `title` — fail-loud, never a silent wedge or clobber.
"""
import glob
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _apply_common as ac  # noqa: E402

HOME = os.path.expanduser("~")
STORE = os.path.join(HOME, ".claudemods", "shared-memory")
LOCK = os.path.join(STORE, ".distill.lock")   # the one store lock, shared with the apply scripts
LOCAL = os.path.join(STORE, "local")
TOMBSTONE = "contradicted — pending review"   # pinned marker (shared with review-scan / the skill)
DOMAIN_RE = re.compile(r"^[A-Za-z0-9_-]+$")   # ASCII slug; anything else can't round-trip through
                                              # INDEX_RE / a projection filename — refuse it
RESERVED_DOMAINS = {"local"}                  # 'local' would collide with the flat personal index
                                              # (MEMORY.local.md) — reserved, never a domain


def parse_list(v):
    v = (v or "").strip()
    if v.startswith("[") and v.endswith("]"):
        v = v[1:-1]
    return [x.strip().strip('"').strip("'") for x in v.split(",") if x.strip()]


def load_memories():
    """Every live memory body (top-level + local/), parsed. Excludes the indexes, RETIRED.md,
    dot-files, and local/archive/ originals — the same set is_memory_file covers."""
    mems = []
    for d, is_local in ((STORE, False), (LOCAL, True)):
        for p in sorted(glob.glob(os.path.join(d, "*.md"))):
            base = os.path.basename(p)
            if base.startswith(".") or base == "RETIRED.md" or ac.INDEX_RE.match(base):
                continue
            with open(p, encoding="utf-8") as f:
                raw = f.read()
            fields, _ = ac.parse_frontmatter(raw)
            unparsed = fields is None   # no frontmatter block — can't read its tags/basis/doctrine
            fields = fields or {}
            mems.append({
                "path": p,
                "link": os.path.relpath(p, STORE),          # "feedback_x.md" or "local/pref.md"
                "unparsed": unparsed,
                "name": fields.get("name") or os.path.splitext(base)[0].replace("_", "-"),
                "title": fields.get("title", ""),
                "description": fields.get("description", ""),
                "type": fields.get("type", ""),
                "applies_when": fields.get("applies_when", ""),
                "domains": list(dict.fromkeys(parse_list(fields.get("domains", "")))),  # dedup, keep order ([8])
                "doctrine": fields.get("doctrine") == "true",
                "basis": fields.get("basis", ""),
                "is_local": is_local,
            })
    return mems


def projected(m):
    """A memory whose line lives in projections (not the flat index): domain-tagged and not
    doctrine. Doctrine always rides the flat always-loaded tier regardless of any tag."""
    return bool(m["domains"]) and not m["doctrine"]


def render_desc(m):
    desc = m["description"]
    if m["type"] == "framework" and m["applies_when"]:
        aw = " / ".join(parse_list(m["applies_when"]))
        if aw:
            desc = f"fires on {aw}: " + (desc[:1].lower() + desc[1:] if desc else desc)
    return desc


def render_line(m):
    """The index line for a memory, rendered from the body. A contradicted body renders AS the
    tombstone (basis-aware) so quarantine is body-driven and survives regen."""
    if m["basis"] == "contradicted":
        return f"- [{TOMBSTONE}]({m['link']})"
    return f"- [{m['title']}]({m['link']}) — {render_desc(m)}"


def projection_name(domain, is_local):
    return f"MEMORY.local.{domain}.md" if is_local else f"MEMORY.{domain}.md"


def desired_projections(mems):
    """{projection_filename: sorted [line]} for every domain-tagged non-doctrine memory.
    A [a, b] memory contributes its line to both a's and b's projections (union)."""
    errs = []
    files = {}
    for m in mems:
        if not projected(m):
            continue
        if not m["title"] and m["basis"] != "contradicted":
            errs.append(f"{m['link']}: projected memory has no `title` (run --backfill-titles)")
        bad = [d for d in m["domains"] if not DOMAIN_RE.match(d) or d in RESERVED_DOMAINS]
        if bad:
            # a malformed domain (space, '/', '.') would mint a projection filename the tool can
            # neither see (INDEX_RE), re-sync, clean, nor roll back — and a '/' would crash the
            # write; a 'local' domain would collide with / overwrite the flat personal index.
            # Refuse loudly, like the missing-title guard, rather than silently wedge or clobber.
            errs.append(f"{m['link']}: invalid domain tag(s) {bad} — domains must match [A-Za-z0-9_-] and not be 'local'")
            continue
        line = render_line(m)
        for dom in m["domains"]:
            files.setdefault(projection_name(dom, m["is_local"]), []).append((m["name"], line))
    return {fn: [ln for _, ln in sorted(v)] for fn, v in files.items()}, errs


def projection_files_on_disk():
    """Existing MEMORY.<domain>.md / MEMORY.local.<domain>.md files — anything matching the
    index pattern that isn't the two flat indexes."""
    out = []
    for p in glob.glob(os.path.join(STORE, "MEMORY.*.md")):
        base = os.path.basename(p)
        if base in ("MEMORY.local.md",) or not ac.INDEX_RE.match(base):
            continue
        out.append(base)
    return sorted(out)


def header(fn):
    return "# Domain index (generated by gen-projections — do not hand-edit)\n"


def write_file(base, lines):
    dest = os.path.join(STORE, base)
    body = header(base) + "\n" + "".join(l + "\n" for l in lines)
    tmp = dest + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(body)
    os.replace(tmp, dest)


def flat_indexes():
    return [os.path.join(STORE, "MEMORY.md"), os.path.join(STORE, "MEMORY.local.md")]


def projected_paths(mems):
    return {os.path.realpath(m["path"]) for m in mems if projected(m)}


def slim_flat(mems):
    """Remove from the flat indexes any line whose target body is projected. Leaves []-lines
    and doctrine lines exactly as the belief channel wrote them."""
    drop = projected_paths(mems)
    for idx in flat_indexes():
        if not os.path.exists(idx):
            continue
        kept, changed = [], False
        for line in open(idx, encoding="utf-8").read().splitlines():
            t = ac.index_line_target(line, idx)
            if t and os.path.realpath(t) in drop:
                changed = True
                continue
            kept.append(line)
        if changed:
            tmp = idx + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                f.write("\n".join(kept) + "\n")
            os.replace(tmp, idx)


def regenerate(mems):
    # a body with no frontmatter can't be classified (tags/doctrine unknown) — refuse loudly
    # rather than silently treat it as untagged (which would leave a domain memory mis-scoped
    # in the always-loaded flat tier). Fail-closed, like the domain/title guards.
    unparsed = [m["link"] for m in mems if m["unparsed"]]
    if unparsed:
        sys.stderr.write("gen-projections: refusing — unparseable frontmatter in:\n  "
                         + "\n  ".join(unparsed) + "\n")
        return 2
    desired, errs = desired_projections(mems)
    if errs:
        sys.stderr.write("gen-projections: refusing to generate —\n  " + "\n  ".join(errs) + "\n")
        return 2
    # write/refresh desired projections; remove stale projection files no longer desired
    for base, lines in desired.items():
        write_file(base, lines)
    for base in projection_files_on_disk():
        if base not in desired:
            os.remove(os.path.join(STORE, base))
    slim_flat(mems)
    print(f"gen-projections: {len(desired)} projection(s); "
          f"{sum(len(v) for v in desired.values())} line(s); flat index slimmed.")
    return 0


def _flat_titles():
    """body realpath → its current flat-index title (skipping tombstone lines), so the backfill
    can lift the human title that lived only in the index line into the body."""
    titles = {}
    for idx in flat_indexes():
        if not os.path.exists(idx):
            continue
        for line in open(idx, encoding="utf-8").read().splitlines():
            m = re.match(r"^- \[([^\]]*)\]\(([^)]+)\)", line)
            if not m or m.group(1) == TOMBSTONE:
                continue
            body = ac.index_line_target(line, idx)
            if body:
                titles[os.path.realpath(body)] = m.group(1)
    return titles


def backfill_titles(mems):
    """One-time migration: add a `title:` frontmatter field to every body that lacks one, taken
    from its current flat-index title. Run BEFORE the first generate (the doctrine now requires
    title, and the generator refuses a projected body without it). Idempotent; leaves a body that
    already has a title untouched, and reports any body whose title can't be recovered."""
    titles = _flat_titles()
    done, missing = [], []
    for m in mems:
        if m["title"] or m["basis"] == "contradicted":
            continue
        t = titles.get(os.path.realpath(m["path"]))
        if not t:
            missing.append(m["link"])
            continue
        raw = open(m["path"], encoding="utf-8").read()
        # insert `title: <t>` right after the top-level `name:` line (function replacement, so the
        # title text is never interpreted as a regex backreference)
        new, n = re.subn(r"(?m)^name:.*\n", lambda mo: mo.group(0) + f"title: {t}\n", raw, count=1)
        if n == 0:  # no name line — insert just after the opening fence
            new = re.sub(r"\A---\n", f"---\ntitle: {t}\n", raw, count=1)
        tmp = m["path"] + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(new)
        os.replace(tmp, m["path"])
        done.append(m["link"])
    print(f"gen-projections --backfill-titles: added title to {len(done)} body(ies).")
    if missing:
        sys.stderr.write("  no flat-index title found for (add `title:` by hand):\n    "
                         + "\n    ".join(missing) + "\n")
        return 3
    return 0


def flatten(mems):
    """Inverse: re-inline every projected memory's line into the flat index (belief-channel
    form) and delete the projection files. The M4 rollback pre-step."""
    add = {os.path.join(STORE, "MEMORY.md"): [], os.path.join(STORE, "MEMORY.local.md"): []}
    for m in mems:
        if not projected(m):
            continue
        idx = os.path.join(STORE, "MEMORY.local.md" if m["is_local"] else "MEMORY.md")
        add[idx].append(render_line(m))
    for idx, lines in add.items():
        if not lines:
            continue
        existing = open(idx, encoding="utf-8").read() if os.path.exists(idx) else "# Index\n"
        have = set(existing.splitlines())
        new = [l for l in lines if l not in have]
        if new:
            sep = "" if existing.endswith("\n") else "\n"
            tmp = idx + ".tmp"                 # temp+rename (atomic), matching write_file/slim_flat
            with open(tmp, "w", encoding="utf-8") as f:
                f.write(existing + sep + "\n".join(new) + "\n")
            os.replace(tmp, idx)
    for base in projection_files_on_disk():
        os.remove(os.path.join(STORE, base))
    print(f"gen-projections --flatten: re-inlined {sum(len(v) for v in add.values())} line(s); "
          f"projection files removed.")
    return 0


def check(mems):
    """Dry-run drift check: desired projections == on-disk, and no projected line sits in the
    flat index. Exit 3 on drift (for the doctor's projection-integrity)."""
    desired, errs = desired_projections(mems)
    # an unparseable body makes a real `gen-projections` (generate) refuse (exit 2); report it
    # here too, so the doctor's projection-integrity can't flash green on a store its own
    # remediation would reject.
    problems = [f"unparseable frontmatter: {m['link']}" for m in mems if m["unparsed"]]
    problems += list(errs)
    on_disk = set(projection_files_on_disk())
    for base in set(desired) | on_disk:
        want = desired.get(base)
        if want is None:
            problems.append(f"orphan projection file: {base}")
            continue
        cur = open(os.path.join(STORE, base), encoding="utf-8").read() if base in on_disk else None
        if cur != header(base) + "\n" + "".join(l + "\n" for l in want):
            problems.append(f"projection out of sync: {base}")
    drop = projected_paths(mems)
    for idx in flat_indexes():
        if not os.path.exists(idx):
            continue
        for line in open(idx, encoding="utf-8").read().splitlines():
            t = ac.index_line_target(line, idx)
            if t and os.path.realpath(t) in drop:
                problems.append(f"projected memory still has a flat-index line: {line.strip()[:60]}")
    if problems:
        print("gen-projections --check: OUT OF SYNC —\n  " + "\n  ".join(problems))
        return 3
    print("gen-projections --check: projections in sync.")
    return 0


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg in ("-h", "--help"):
        print(__doc__)
        return 0
    if arg == "--check":
        # Acquire the store lock for the duration of the read (run-window exclusion): a generate
        # holds the lock across ALL its projection writes + the flat slim, so a lock-free check
        # could see a half-written store and report SPURIOUS drift. Lock held → a generate /
        # backfill / flatten / map-repo is in flight → report SKIPPED (exit 4), not drift; the
        # doctor maps 4 to a skip, not a warn. Otherwise check a consistent, snapshot-under-lock.
        try:
            fd = ac.acquire_lock(LOCK)
        except ac.LockHeld:
            print("gen-projections --check: skipped — store lock held (a generate is in flight)")
            return 4
        try:
            return check(load_memories())
        finally:
            ac.release_lock(fd, LOCK)
    try:
        fd = ac.acquire_lock(LOCK)
    except ac.LockHeld:
        sys.stderr.write(f"gen-projections: store lock held ({LOCK}) — another batch in flight?\n")
        return 2
    try:
        mems = load_memories()   # load UNDER the lock ([9]) — a concurrent apply can't commit between
        if arg == "--flatten":   # the read and the write, mirroring --check's snapshot-under-lock
            return flatten(mems)
        if arg == "--backfill-titles":
            return backfill_titles(mems)
        if arg in ("", "--generate"):
            return regenerate(mems)
        sys.stderr.write(f"gen-projections: unknown argument {arg!r} (try --help)\n")
        return 2
    finally:
        ac.release_lock(fd, LOCK)


if __name__ == "__main__":
    sys.exit(main())
