#!/usr/bin/env python3
"""distill-scan: the mechanical front of /memory-distill.

Walks the candidate queue and the project memory dirs, emits one flat JSON
candidate list on stdout: frontmatter parsed fail-soft, content hashes for
apply-time staleness checks, advisory name/description similarity scores,
RETIRED.md attached whole with exact-name matches flagged, and a queue-path-only
`recall_miss` flag (M3) when a re-captured candidate matches an already-promoted
memory — the index line didn't fire, so enrich it (never retire).

Scripts never author beliefs; this one only reads.
"""
import difflib
import glob
import hashlib
import json
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import _apply_common as ac  # noqa: E402  (sibling in bin/; shared INDEX_RE)

HOME = os.path.expanduser("~")
STORE = os.path.join(HOME, ".claudemods", "shared-memory")
PROJECTS = os.path.join(HOME, ".claude", "projects")
SIMILARITY_FLOOR = 0.45  # advisory hints only; the skill judges over the flat list
# recall-MISS (M3): a re-captured candidate matching an already-promoted memory ⇒ the index
# line didn't fire. UNCALIBRATED — 0.45 was tuned for candidate-vs-candidate clustering, not
# candidate-vs-promoted-set; set conservatively high so it rarely false-fires until it can be
# calibrated on real candidate-vs-promoted pairs (m3.md §Signal 1). Emits enrich/investigate,
# never retire.
RECALL_MISS_FLOOR = 0.7
INDEX_NAME_RE = ac.INDEX_RE   # centralized (M4): matches MEMORY.md / .local.md / .<domain>.md / .local.<domain>.md


def parse_frontmatter(text):
    """Fail-soft frontmatter parse. Returns (fields|None, body, error|None)."""
    m = re.match(r"\A---\n(.*?)\n---\n?(.*)\Z", text, re.S)
    if not m:
        return None, text, "no frontmatter block"
    fields, body, err = {}, m.group(2), None
    try:
        for line in m.group(1).splitlines():
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            km = re.match(r"\s*([A-Za-z_]+):\s*(.*?)\s*(#.*)?$", line)
            if km:
                fields[km.group(1)] = km.group(2).strip().strip('"')
    except Exception as e:  # keep the candidate; flag the drift
        err = f"frontmatter parse error: {e}"
    return fields, body, err


def memory_dirs():
    """Project memory dirs, worktree session dirs skipped; honors a user-scope
    autoMemoryDirectory override (per-project scopes are the doctor's walk —
    unwalkable here without the lossy dash decoding; noted, not guessed)."""
    dirs = []
    for d in sorted(glob.glob(os.path.join(PROJECTS, "*", "memory"))):
        project = os.path.basename(os.path.dirname(d))
        if "--claude-worktrees-" in project:
            continue
        dirs.append((project, d))
    # user scope only: ~/.claude/settings.json. settings.local.json is PROJECT-local
    # (.claude/settings.local.json), not a user file — per-project scopes are the doctor's
    # M3 walk (lossy dash-decoding), not read here.
    try:
        with open(os.path.join(HOME, ".claude", "settings.json")) as f:
            override = json.load(f).get("autoMemoryDirectory")
        if override:
            p = os.path.expanduser(override)
            if os.path.isdir(p):
                dirs.append(("autoMemoryDirectory", p))
    except (FileNotFoundError, json.JSONDecodeError):
        pass
    return dirs


def _read_text(path):
    """Fail-soft read: '' on missing / OSError / non-UTF-8. A bad byte ANYWHERE in the store must
    never abort the whole scan ([17]) — this backs every scan-time store/queue/ledger read."""
    try:
        return open(path, encoding="utf-8").read()
    except (OSError, UnicodeError):
        return ""


def candidate_from_file(project, path):
    try:
        raw = open(path, encoding="utf-8").read()
    except (OSError, UnicodeError) as e:   # a non-UTF-8/unreadable file flags the candidate, never crashes ([17])
        # keep the candidate shape uniform (name/description) so the similarity + ledger passes in
        # main() don't KeyError on an error-candidate — it stays in the batch, flagged via `error`
        return {"path": path, "project": project, "error": str(e),
                "name": os.path.basename(path), "description": ""}
    fields, body, err = parse_frontmatter(raw)
    cand = {
        "path": path,
        "project": project,
        "sha256": hashlib.sha256(raw.encode()).hexdigest(),
        "name": (fields or {}).get("name") or os.path.basename(path),
        "description": (fields or {}).get("description", ""),
        "type": (fields or {}).get("type", ""),
        "basis": (fields or {}).get("basis", ""),
        "body": body,
    }
    if err:
        cand["parse_flag"] = err  # fail-soft: flagged, never dropped
    return cand


def _name_desc(path):
    try:
        raw = open(path, encoding="utf-8").read()
    except (OSError, UnicodeError):
        return None
    fields, _, _ = parse_frontmatter(raw)
    fields = fields or {}
    name = fields.get("name") or os.path.splitext(os.path.basename(path))[0].replace("_", "-")
    return name, fields.get("description", "")


def promoted_set(store):
    """(name, description) of already-promoted memories, for the recall-MISS match: the live
    top-level + local/ memories, plus PROMOTION originals under local/archive/. A memory has
    no index line once RETIRED, so 'the line didn't fire' is meaningless for it — and
    retirement writes the original body (stamped `retired_from`) into local/archive/ as its
    commit point and never removes it, so a retirement archive must be EXCLUDED here or a
    retired re-capture double-labels (recall_miss under a name with no line, on top of the
    retired_name_match tripwire). Archive matching is SOLO-ONLY (local/ is gitignored); a
    group clone falls back to the live memories alone."""
    out = []
    for d in (store, os.path.join(store, "local"), os.path.join(store, "local", "archive")):
        is_archive = d.endswith(os.path.join("local", "archive"))
        for p in sorted(glob.glob(os.path.join(d, "*.md"))):
            base = os.path.basename(p)
            if base.startswith(".") or base == "RETIRED.md" or INDEX_NAME_RE.match(base):
                continue
            fields, _, _ = parse_frontmatter(_read_text(p))   # fail-soft: a bad-byte body is skipped, not fatal ([17])
            fields = fields or {}
            if is_archive and fields.get("retired_from"):
                continue  # a retirement archive, not a promotion original — no live index line
            name = fields.get("name") or os.path.splitext(base)[0].replace("_", "-")
            out.append((name, fields.get("description", "")))
    return out


def project_of(path):
    parts = os.path.abspath(path).split(os.sep)
    if "projects" in parts:
        i = parts.index("projects")
        if i + 1 < len(parts):
            return parts[i + 1]
    return os.path.basename(os.path.dirname(os.path.dirname(path))) or "queue"


def read_consumed(store):
    """The consumed-occurrence ledger: a set of 0-based queue-line offsets."""
    consumed, p = set(), os.path.join(store, ".candidates.consumed")
    for line in _read_text(p).splitlines():
        line = line.strip()
        if line.isdigit():
            consumed.add(int(line))
    return consumed


def read_queue(store):
    """Live queue: (offset, line) for each .candidates.log line whose 0-based
    physical index (blanks counted — the append-only log is never rewritten, so
    the index is a stable occurrence id) isn't in .candidates.consumed."""
    qpath, consumed, live = os.path.join(store, ".candidates.log"), read_consumed(store), []
    # splitlines preserves the 0-based physical index (blanks counted), matching per-line iteration;
    # _read_text degrades a bad-byte/unreadable log to '' rather than aborting the scan ([17]).
    for idx, raw in enumerate(_read_text(qpath).splitlines()):
        if idx in consumed:
            continue
        line = raw.strip()
        if line:
            live.append((idx, line))
    return live


def classify_queue(live):
    """Three kinds. A `file` path is de-duped to one entry carrying every live offset
    that collapsed into it (so consuming the candidate consumes them all); a real
    `reflect-pointer:` is `passthrough`; anything else is a `stale` dead path."""
    files, order, others = {}, [], []
    for off, line in live:
        if os.path.isfile(line):
            if line not in files:
                files[line] = []
                order.append(line)
            files[line].append(off)
        elif line.startswith("reflect-pointer:"):
            others.append({"kind": "passthrough", "entry": line, "offset": off})
        else:
            others.append({"kind": "stale", "entry": line, "offset": off})
    return [{"kind": "file", "path": p, "offsets": files[p]} for p in order] + others


def main():
    queue_only = "--queue-only" in sys.argv[1:]
    queue_entries = classify_queue(read_queue(STORE))
    candidates, seen = [], set()

    if queue_only:
        # incremental path: ingest each live `file` queue entry as a candidate, skip the glob
        for e in queue_entries:
            if e["kind"] == "file" and e["path"] not in seen:
                seen.add(e["path"])
                candidates.append(candidate_from_file(project_of(e["path"]), e["path"]))
    else:
        for project, mdir in memory_dirs():
            for path in sorted(glob.glob(os.path.join(mdir, "**", "*.md"), recursive=True)):
                if os.path.basename(path) == "MEMORY.md" or path in seen:
                    continue
                seen.add(path)
                candidates.append(candidate_from_file(project, path))

    # advisory similarity hints — never partitions
    keys = [(c["name"] + " " + c["description"]).lower() for c in candidates]
    for i, c in enumerate(candidates):
        hints = []
        for j, other in enumerate(candidates):
            if i == j:
                continue
            score = difflib.SequenceMatcher(None, keys[i], keys[j]).ratio()
            if score >= SIMILARITY_FLOOR:
                hints.append({"path": other["path"], "score": round(score, 2)})
        if hints:
            c["similar"] = sorted(hints, key=lambda h: -h["score"])[:5]

    retired_path = os.path.join(STORE, "RETIRED.md")
    retired = _read_text(retired_path)   # fail-soft ([17])
    retired_names = set(re.findall(r"^- (\S+)", retired, re.M))
    for c in candidates:
        if c.get("name") in retired_names:
            c["retired_name_match"] = True  # a tripwire, not the check

    # recall-MISS (M3): QUEUE-PATH-ONLY — only a candidate with a live (unconsumed) queue
    # occurrence can be a re-capture; a glob-only candidate (e.g. a promoted-but-slimmed
    # original still on disk) must never flag, or it false-positives on every scan.
    queued_paths = {e["path"] for e in queue_entries if e["kind"] == "file"}
    promoted = promoted_set(STORE)
    pkeys = [(n + " " + d).lower() for n, d in promoted]
    for i, c in enumerate(candidates):
        if c["path"] not in queued_paths or "name" not in c:
            continue
        if c.get("name") in retired_names:
            continue  # a retired re-capture is retired_name_match, not recall_miss (no index line)
        best_s, best_n = 0.0, None
        for (pn, _pd), pk in zip(promoted, pkeys):
            s = difflib.SequenceMatcher(None, keys[i], pk).ratio()
            if s > best_s:
                best_s, best_n = s, pn
        if best_n and best_s >= RECALL_MISS_FLOOR:
            # the index line didn't fire → enrich/investigate it, NEVER retire the memory
            c["recall_miss"] = {"matched": best_n, "score": round(best_s, 2)}

    by_project = {}
    for c in candidates:
        by_project[c["project"]] = by_project.get(c["project"], 0) + 1
    json.dump(
        {
            # summary first: the ledger the skill's batch shape must reconcile to,
            # placed where a paginated read cannot miss it
            "summary": {
                "total_candidates": len(candidates),
                "by_project": by_project,
                "parse_flags": sum(1 for c in candidates if "parse_flag" in c),
                "queue_entries": len(queue_entries),
            },
            "store": STORE,
            "candidates": candidates,
            "queue": queue_entries,
            "retired_ledger": retired,
        },
        sys.stdout,
        indent=1,
    )
    print()


if __name__ == "__main__":
    main()
