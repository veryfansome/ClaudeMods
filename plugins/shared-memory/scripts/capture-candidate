#!/usr/bin/env python3
"""capture-candidate: PostToolUse (Write|Edit) handler — enqueue a just-written
project auto-memory file onto the distill candidate queue.

Reads the hook payload on stdin, re-checks that tool_input.file_path is a project
auto-memory `.md` (under ~/.claude/projects/<proj>/memory/, not MEMORY.md, not a
worktree session dir), and O_APPENDs it to the store's .candidates.log.

Fail-soft: a non-memory path, a malformed payload, or an I/O hiccup is a silent
exit 0 — plumbing never blocks or errors a session. The re-check is *lexical*
(abspath, not realpath): capture only appends a path the file tools already wrote,
and symlink/`..` canonicalization is the apply guard's job, not capture's. Scripts
never author beliefs; this only records a path.
"""
import json
import os
import re
import sys

HOME = os.path.expanduser("~")
STORE = os.path.join(HOME, ".claudemods", "shared-memory")
QUEUE = os.path.join(STORE, ".candidates.log")
# project auto-memory only: ~/.claude/projects/<proj>/memory/**/*.md. The shared store
# lives under ~/.claudemods/, naturally outside this scope.
MEMORY_RE = re.compile(re.escape(os.path.join(HOME, ".claude", "projects")) + r"/[^/]+/memory/.*\.md$")


def main():
    try:
        path = (json.load(sys.stdin).get("tool_input") or {}).get("file_path", "")
    except Exception:
        return 0  # malformed payload → silent no-op
    if not path:
        return 0
    path = os.path.abspath(path)  # lexical normalize (., ..); symlink resolution is the apply guard's job
    if not MEMORY_RE.match(path) or os.path.basename(path) == "MEMORY.md" or "--claude-worktrees-" in path:
        return 0
    if "\n" in path:
        return 0  # [R9] D7: a path with an embedded newline would forge a second queue line (mirror reflect-scan)
    try:
        os.makedirs(STORE, exist_ok=True)
        # O_APPEND: lock-free and append-vs-append safe; the queue is never rewritten in place
        fd = os.open(QUEUE, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
        try:
            os.write(fd, (path + "\n").encode("utf-8"))
        finally:
            os.close(fd)
    except OSError:
        return 0  # I/O hiccup → silent no-op
    return 0


if __name__ == "__main__":
    sys.exit(main())
