#!/usr/bin/env python3
"""log-recall: PostToolUse (Read) handler — the read-telemetry logger behind the
body-read-as-index-INSUFFICIENCY signal (M3).

When a session Reads a store memory BODY on demand, that means the always-loaded index
line was too weak to steer alone — so the line is a candidate to ENRICH (never to retire;
absence of reads is never a signal). This logs the read; /memory-review's recall audit
turns the log into per-line enrich recommendations, type-gated (a `reference` read is
correct use, not insufficiency).

DOCTRINE IS NOT LOGGED. distill and review read all five doctrine bodies by instruction
every run; logging those would nudge "enrich" on the most-loaded memories — the very
inversion the §2 telemetry was rejected for, one level down. So a `doctrine: true` file is
skipped here even though is_memory_file() still qualifies it (eval-memory needs doctrine
covered for near-dup; the two callers differ deliberately).

Fail-soft: a non-body path, a malformed payload, or an I/O hiccup is a silent exit 0 —
plumbing never blocks or errors a session. Append-only (O_APPEND), never rewritten, like
the capture queue. Scripts never author beliefs; this only records a read.
"""
import json
import os
import sys
import time

HOME = os.path.expanduser("~")
STORE = os.path.join(HOME, ".claudemods", "shared-memory")
RECALL_LOG = os.path.join(STORE, ".recall.log")

# reach the sibling bin/ for the shared body/index predicate + doctrine check
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "bin"))
import _apply_common as ac  # noqa: E402


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return 0  # malformed payload → silent no-op
    if not isinstance(payload, dict):
        return 0
    path = (payload.get("tool_input") or {}).get("file_path", "")
    if not path:
        return 0
    path = os.path.abspath(path)  # lexical normalize; the store-body test is the guard
    # only a genuine non-doctrine memory body: is_memory_file already excludes indexes,
    # RETIRED.md, local/archive/ originals, and dot-files; is_doctrine_file drops doctrine.
    if not ac.is_memory_file(path) or ac.is_doctrine_file(path):
        return 0
    rec = {"path": os.path.relpath(path, STORE), "ts": time.time(),
           "session": payload.get("session_id", "")}
    try:
        os.makedirs(STORE, exist_ok=True)
        fd = os.open(RECALL_LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
        try:
            os.write(fd, (json.dumps(rec) + "\n").encode("utf-8"))
        finally:
            os.close(fd)
    except OSError:
        return 0  # I/O hiccup → silent no-op
    return 0


if __name__ == "__main__":
    sys.exit(main())
