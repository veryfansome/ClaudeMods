#!/usr/bin/env python3
"""evolve — deterministic backend CLI for the evolve plugin's search loop.

The skills (/evolve:init, /evolve:round, /evolve:status) converse and orchestrate
inventors; this CLI decides. Verbs:

  init            scaffold evolve/ into the project (idempotent)
  doctor          contract health pass; --measure-noise writes the measured floor
  seed            score + archive the unmodified baseline as gen 0
  sample          parent + operator + inspirations per inventor slot (budget-enforced);
                  persists the slot table to evolve/rounds/ — the assignment is the round's
                  evidence base, distinct from what candidates later CLAIM as --parent
  brief           the full inventor brief context for one slot (markdown). --diet emits
                  the information-diet form instead: parent genome + parent fitness +
                  baseline + prior mechanisms as SOURCE with no outcome attached — and
                  refuses to emit at all if its own leak assertions trip
  jail            build one registry inventor's isolated workspace: the diet brief, the
                  project-declared harness files, exactly the granted impl sources, and
                  PROPOSAL/ — nothing else (the archive, the config and project docs are
                  deliberately absent). The diet cleans the channel; the jail makes it
                  the ONLY channel — they are sufficient only together
  guard           validate a candidate (worktree or genome) without scoring
  score           guard -> dedup -> pristine-clone eval -> record
  rescore         re-run an archived candidate under a new mode/split, reusing its id
                  (proxy->full re-score, paired rerun, final-split validation)
  ingest          append an externally-scored result (tag --env; scores only compare
                  within one environment). A retracted id refuses numeric ingests unless
                  --reinstate — reinstatement is a decision, not a wave side effect
  retract         append an explicit retraction for an archived id: its earlier scores stop
                  counting (in every partition — a validity verdict is a property of the
                  mechanism, not the dataset); history stays; a deliberate rescore reinstates
  board           leaderboard + budget + neutral per-inventor/operator stats
  impls           list registered impls for a registry axis
  apply           materialize an archived candidate: print its genome (registry) or apply
                  its patch to the working tree (markers); --dry prints without applying.
                  Retrieval only — the search has no promotion/adoption step; validity is
                  per-candidate (eval.guardrails at score time, retraction post hoc), and
                  what you do with an artifact downstream is outside the engine

Exit codes: 0 ok · 1 error · 2 doctor/config failure · 3 budget exhausted ·
4 guard violation · 5 novelty rejection · 6 infrastructure failure (export/setup — NOT
archived, retry). 4/5 are Reflexion feedback (re-brief the inventor, don't archive)."""

import argparse
import json
import pathlib
import random
import subprocess
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

from _evolve import archive, board, brief, config as cfgmod, diet, doctor, jail, rounds, runner, scaffold, score, surface  # noqa: E402


def find_root(explicit):
    if explicit:
        return pathlib.Path(explicit).resolve()
    r = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if r.returncode == 0:
        return pathlib.Path(r.stdout.strip())
    return pathlib.Path.cwd()


def _fail(msg, code=1):
    print(json.dumps({"error": msg}), file=sys.stderr)
    raise SystemExit(code)


def _meta(args):
    return {"id": args.id, "parent": args.parent, "inventor": args.inventor,
            "operator": args.operator, "axis_changed": getattr(args, "axis_changed", None),
            "rationale": args.rationale, "generation": getattr(args, "generation", None)}


def _check_split(cfg, split):
    allowed = set(cfg["eval"]["splits"]) | {cfgmod.FINAL_SPLIT}
    if split not in allowed:
        _fail(f"unknown --split {split!r}; declared splits are {sorted(allowed)} "
              f"(a typo'd split silently defeats the holdout firewall)", code=2)


def cmd_init(root, args):
    print(json.dumps(scaffold.init(root, mode=args.mode), indent=1))


def cmd_doctor(root, args):
    if args.measure_env_offset:
        res = doctor.measure_env_offset(root, ref_id=args.ref, dry=args.dry)
        print(json.dumps(res, indent=1))
        raise SystemExit(0 if res.get("ok") else 2)
    res = doctor.run(root, run_eval=args.run_eval, measure_noise=args.measure_noise, dry=args.dry,
                     force=args.force)
    print(json.dumps(res, indent=1))
    raise SystemExit(0 if res["ok"] else 2)


def cmd_seed(root, args):
    cfg = cfgmod.load(root)
    _check_split(cfg, args.split)
    rec = score.score_seed(root, cfg, mode=args.mode, split=args.split, env=args.env,
                           seed_id=args.id, no_archive=args.no_archive)
    print(json.dumps(rec, indent=1))


def cmd_sample(root, args):
    cfg = cfgmod.load(root)
    sel_env = cfg["fitness"].get("selection_env")
    state = archive.budget_state(root, cfg["budget"], sel_env)
    if state["exhausted"]:
        print(json.dumps({"budget": state}), file=sys.stderr)
        _fail("budget exhausted: " + "; ".join(state["exhausted"]), code=3)
    probs = cfg["search"]["op_probs"]
    axes = sorted(cfg["surface"]["registry"]["axes"]) if cfg["surface"]["mode"] == "registry" else []
    valid_ids = [r["id"] for r in archive.leaderboard(root, 50, sel_env)]
    slots = []
    for i in range(args.k):
        slot_seed = f"{args.seed}:{i}"
        parent = archive.sample_parent(root, seed=slot_seed, lam=cfg["search"]["lambda"],
                                       selection_env=sel_env,
                                       noise_floor=cfg["fitness"].get("noise_floor"))
        ops, weights = zip(*probs.items())
        op = random.Random(f"op:{slot_seed}").choices(ops, weights=weights, k=1)[0]
        cross_with = None
        if op == "cross":
            partners = [i_ for i_ in valid_ids if not parent or i_ != parent["id"]]
            if partners:
                cross_with = random.Random(f"cross:{slot_seed}").choice(partners)
            else:
                op = "diff"  # nothing to cross with yet
        insp = archive.sample_inspirations(root, parent["id"] if parent else None,
                                           n_top=cfg["search"]["inspirations"]["top_k"],
                                           n_archive=cfg["search"]["inspirations"]["archive"],
                                           seed=slot_seed, selection_env=sel_env)
        slot = {"slot": i, "parent": parent["id"] if parent else None,
                "parent_fitness": parent["fitness"] if parent else None,
                "operator": op, "cross_with": cross_with,
                "inspirations": [r["id"] for r in insp], "seed": slot_seed}
        if axes:  # registry: pick which axis this slot mutates (round-robins across axes)
            slot["axis"] = axes[i % len(axes)]
        slots.append(slot)
    if args.dry:
        # diagnostics (pressure checks, verification draws) must not pollute evolve/rounds/
        # with slot files for rounds nobody will dispatch
        print(json.dumps({"slots": slots, "budget": state, "dry": True}, indent=1))
        return
    slots_file = rounds.save_slots(root, args.seed, slots)   # assignments must outlive stdout
    print(json.dumps({"slots": slots, "budget": state,
                      "slots_file": str(slots_file.relative_to(root))}, indent=1))


def cmd_brief(root, args):
    cfg = cfgmod.load(root)
    if args.diet:
        text, _, warns = diet.build(root, cfg, operator=args.operator, parent_id=args.parent,
                                    axis=args.axis, cross_with=args.cross_with, seed=args.seed,
                                    baseline_id=args.baseline_id,
                                    baseline_fitness=args.baseline_fitness)
        for w in warns:
            print(f"warn: {w}", file=sys.stderr)
        print(text, end="")
        return
    print(brief.build(root, cfg, operator=args.operator, parent_id=args.parent,
                      axis=args.axis, cross_with=args.cross_with, seed=args.seed))


def cmd_jail(root, args):
    cfg = cfgmod.load(root)
    path, warnings = jail.build(root, cfg, parent_id=args.parent, axis=args.axis,
                                round_tag=args.round, slot=args.slot, operator=args.operator,
                                cross_with=args.cross_with, seed=args.seed,
                                jail_root=args.jail_root, force=args.force,
                                baseline_id=args.baseline_id,
                                baseline_fitness=args.baseline_fitness)
    for w in warnings:
        print(f"warn: {w}", file=sys.stderr)
    print(json.dumps({"jail": str(path),
                      "note": "launch the inventor with this as its cwd; its whole "
                              "grounding is BRIEF.md + JAIL_README.md"}, indent=1))


def cmd_guard(root, args):
    cfg = cfgmod.load(root)
    if args.candidate:
        report = surface.guard_markers(args.candidate, cfg)
    elif args.genome:
        genome = json.loads(pathlib.Path(args.genome).read_text())
        report = surface.guard_registry(genome, root, cfg)
    else:
        _fail("guard needs --candidate <worktree> or --genome <file>")
    print(json.dumps(report, indent=1))
    raise SystemExit(0 if report["ok"] else 4)


def cmd_score(root, args):
    cfg = cfgmod.load(root)
    _check_split(cfg, args.split)
    kwargs = {}
    if args.candidate:
        kwargs["worktree"] = args.candidate
    if args.patch:
        kwargs["patch"] = pathlib.Path(args.patch).read_text()
    if args.genome:
        kwargs["genome"] = json.loads(pathlib.Path(args.genome).read_text())
    if len(kwargs) != 1:
        _fail("score needs exactly one of --candidate | --patch | --genome")
    rec = score.score_candidate(root, cfg, mode=args.mode, split=args.split,   # Rejection -> main (exit 4/5)
                                meta=_meta(args), force=args.force, env=args.env,
                                no_archive=args.no_archive, **kwargs)
    print(json.dumps(rec, indent=1))


def cmd_rescore(root, args):
    cfg = cfgmod.load(root)
    _check_split(cfg, args.split)
    rec = score.rescore(root, cfg, rec_id=args.id, mode=args.mode, split=args.split, env=args.env)
    print(json.dumps(rec, indent=1))


def cmd_ingest(root, args):
    cfg = cfgmod.load(root)
    _check_split(cfg, args.split)
    genome = json.loads(pathlib.Path(args.genome).read_text()) if args.genome else None
    rec = score.ingest(root, cfg, result_text=pathlib.Path(args.result).read_text(),
                       meta=_meta(args), mode=args.mode, split=args.split, env=args.env,
                       genome=genome, reinstate=args.reinstate)
    print(json.dumps({k: rec.get(k) for k in ("id", "fitness", "guardrail", "mode", "split", "env")},
                     indent=1))


def cmd_retract(root, args):
    """First-class retraction: the marker used to require hand-crafting {"retract": true}
    into a result JSON, and both field mis-retractions (8 silent no-ops, one never-effective
    revocation) came from getting that ceremony wrong. Success is judged by EFFECT — the
    verdict must actually register — never by the append going through."""
    cfg = cfgmod.load(root)
    _check_split(cfg, args.split)   # a typo'd split would retract the WRONG partition, silently
    payload = json.dumps({"retract": True, "fitness": None, "guardrail": args.reason})
    rec = score.ingest(root, cfg, result_text=payload, meta={"id": args.id},
                       mode=args.mode, split=args.split, env=args.env)
    verdicts = archive.retracted_ids(archive.load(root), cross_partition=True)
    if verdicts.get(args.id) is None:
        _fail(f"retraction record appended but the verdict registers in NO validity view — "
              f"inspect the archive for id {args.id!r} (this is the silent-no-op class this "
              "verb exists to prevent; it should be unreachable)")
    print(json.dumps({"retracted": args.id, "reason": verdicts[args.id],
                      "scope": "all partitions — a validity verdict is a property of the "
                               f"mechanism; the fitness view drops it in env {rec.get('env')!r}",
                      "record": {k: rec.get(k) for k in ("id", "env", "split", "generation")},
                      "note": "verify by effect: gone from `evolve board` when its env is the "
                              "selection_env; archive.retracted_ids(cross_partition=True) is "
                              "the global view"}, indent=1))


def cmd_board(root, args):
    cfg = cfgmod.load(root)
    rep = board.report(root, cfg, top=args.top)
    print(json.dumps(rep, indent=1) if args.json else board.render(rep))


def cmd_impls(root, args):
    cfg = cfgmod.load(root)
    if cfg["surface"]["mode"] != "registry":
        _fail("impls applies to registry-mode projects")
    axes = [args.axis] if args.axis else sorted(cfg["surface"]["registry"]["axes"])
    retired = surface.retired_impls(root)
    out = {a: [i for i in surface.list_impls(root, cfg, a) if f"{a}/{i}" not in retired]
           for a in axes}   # retired impls are not live options (evolve/retired_impls.json)
    print(json.dumps(out, indent=1))


def cmd_apply(root, args):
    """Materialize an archived candidate's artifact. Retrieval only: no gates, no records —
    the search has no promotion/adoption step (an anchor the search is told to beat is a
    champion at any timescale), so what happens to an artifact downstream is outside the
    engine. Prefers the artifact of the id's AUTHORITATIVE selectable record: ingest has no
    payload check, so a later ingested record can carry a DIFFERENT genome, and handing that
    out under the id would materialize wrong code."""
    cfg = cfgmod.load(root)
    recs = [r for r in archive.load(root) if r.get("id") == args.id]
    if not recs:
        _fail(f"no archived record with id {args.id!r}")
    sel_env = cfg["fitness"].get("selection_env")
    auth = next((r for r in archive.best_per_id(archive.valid(archive.load(root), sel_env))
                 if r["id"] == args.id), None)

    def artifact(r):
        return isinstance(r.get("genome"), dict) or (r.get("surface") or {}).get("patch")

    def seed_shaped(r):
        return ((r.get("surface") or {}).get("mode") == "markers" and r.get("parent") is None
                and not (r.get("surface") or {}).get("patch"))
    if auth is not None and artifact(auth):
        rec = auth
    else:
        # No artifact anywhere — maybe the markers seed (its empty patch is never persisted).
        # Identify it from ANY of the id's records: a later ingest or retraction record carries
        # no surface at all, so testing only the newest record would misread the seed as an
        # artifact-less ingest and fail with a misleading error.
        rec = next((r for r in reversed(recs) if artifact(r)),
                   next((r for r in recs if seed_shaped(r)), recs[-1]))
    out = {"id": args.id}
    if auth is None:
        out["note"] = (f"{args.id!r} has no selectable record (retracted or filtered) — "
                       "its archived scores are not trusted")
    seedish = seed_shaped(rec)
    if isinstance(rec.get("genome"), dict):
        out["genome"] = rec["genome"]
    elif seedish:
        out["note"] = ((out["note"] + "; ") if "note" in out else "") + "the unmodified baseline — nothing to apply"
    else:
        rel = (rec.get("surface") or {}).get("patch")
        if not rel:
            _fail(f"record {args.id!r} carries no artifact (an ingested record holds only its "
                  "score — apply where the candidate was produced)")
        out["patch"] = f"{cfgmod.STATE_DIR}/{rel}"
        if args.dry:
            out["diff"] = (cfgmod.state_dir(root) / rel).read_text()
        else:
            patch = (cfgmod.state_dir(root) / rel).read_text()
            r = subprocess.run(["git", "apply", "--whitespace=nowarn"], input=patch, text=True,
                               capture_output=True, cwd=root)
            if r.returncode != 0:
                _fail(f"patch no longer applies to the working tree: {r.stderr.strip()}")
            out["applied"] = rel
    print(json.dumps(out, indent=1))


def main(argv=None):
    ap = argparse.ArgumentParser(prog="evolve", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--root", default=None, help="project root (default: git toplevel of cwd)")
    sub = ap.add_subparsers(required=True, dest="verb")

    def add_mode_split(p):
        p.add_argument("--mode", default="proxy", choices=["proxy", "full"])
        p.add_argument("--split", default=cfgmod.DEFAULT_SPLIT)
        p.add_argument("--env", default=None)

    def add_meta(p):
        p.add_argument("--id", required=True)
        p.add_argument("--parent", default=None)
        p.add_argument("--inventor", default=None)
        p.add_argument("--operator", default=None)
        p.add_argument("--axis-changed", dest="axis_changed", default=None)
        p.add_argument("--rationale", default=None)
        p.add_argument("--generation", type=int, default=None,
                       help="explicit generation stamp (default: parent's + 1; required when "
                            "--parent names an id this archive doesn't hold)")

    p = sub.add_parser("init"); p.add_argument("--mode", default="markers", choices=["markers", "registry"]); p.set_defaults(fn=cmd_init)
    p = sub.add_parser("doctor"); p.add_argument("--run-eval", action="store_true")
    p.add_argument("--measure-noise", action="store_true"); p.add_argument("--dry", action="store_true")
    p.add_argument("--force", action="store_true",
                   help="allow --measure-noise to overwrite an already-configured noise floor")
    p.add_argument("--measure-env-offset", action="store_true",
                   help="re-run a reference candidate here and record this env's fitness offset")
    p.add_argument("--ref", default=None, help="reference candidate id for --measure-env-offset (default: top-scoring record)")
    p.set_defaults(fn=cmd_doctor)
    p = sub.add_parser("seed"); add_mode_split(p); p.add_argument("--id", default="gen0-baseline")
    p.add_argument("--no-archive", action="store_true"); p.set_defaults(fn=cmd_seed)
    p = sub.add_parser("sample"); p.add_argument("--k", type=int, default=3)
    p.add_argument("--dry", action="store_true",
                   help="diagnostic draw: print slots without persisting a slots file")
    p.add_argument("--seed", required=True,
                   help="round tag — assignments persist to evolve/rounds/<seed>-<hash>-slots.json (exact path printed as slots_file), and "
                        "a round's assignments are immutable evidence, so every round needs a "
                        "fresh seed")
    p.set_defaults(fn=cmd_sample)
    p = sub.add_parser("brief"); p.add_argument("--operator", default="diff", choices=list(cfgmod.OPERATORS))
    p.add_argument("--parent", default=None); p.add_argument("--axis", default=None)
    p.add_argument("--cross-with", dest="cross_with", default=None); p.add_argument("--seed", default="0")
    p.add_argument("--diet", action="store_true",
                   help="emit the information-diet brief: parent + baseline + score-free "
                        "mechanism sources; refuses to emit on any leak")
    p.add_argument("--baseline-id", default="gen0-baseline")
    p.add_argument("--baseline-fitness", type=float, default=None,
                   help="override reading the baseline's fitness from the archive")
    p.set_defaults(fn=cmd_brief)
    p = sub.add_parser("jail"); p.add_argument("--parent", required=True)
    p.add_argument("--axis", required=True); p.add_argument("--round", required=True)
    p.add_argument("--slot", type=int, required=True)
    p.add_argument("--operator", default="diff", choices=list(cfgmod.OPERATORS))
    p.add_argument("--cross-with", dest="cross_with", default=None)
    p.add_argument("--seed", default="0")
    p.add_argument("--jail-root", dest="jail_root", default=None,
                   help="where jails live (default: ~/.cache/evolve-jails/<project> — "
                        "outside the repo so a jail can never be committed)")
    p.add_argument("--force", action="store_true", help="rebuild over an existing jail")
    p.add_argument("--baseline-id", default="gen0-baseline")
    p.add_argument("--baseline-fitness", type=float, default=None)
    p.set_defaults(fn=cmd_jail)
    p = sub.add_parser("guard"); p.add_argument("--candidate", default=None); p.add_argument("--genome", default=None); p.set_defaults(fn=cmd_guard)
    p = sub.add_parser("score"); p.add_argument("--candidate", default=None); p.add_argument("--patch", default=None)
    p.add_argument("--genome", default=None); p.add_argument("--force", action="store_true")
    p.add_argument("--no-archive", action="store_true"); add_meta(p); add_mode_split(p); p.set_defaults(fn=cmd_score)
    p = sub.add_parser("rescore"); p.add_argument("--id", required=True); add_mode_split(p); p.set_defaults(fn=cmd_rescore)
    p = sub.add_parser("ingest"); p.add_argument("--result", required=True); p.add_argument("--genome", default=None)
    p.add_argument("--reinstate", action="store_true",
                   help="deliberately append a numeric score for a RETRACTED id (append order "
                        "then reinstates it)")
    add_meta(p); add_mode_split(p); p.set_defaults(fn=cmd_ingest)
    p = sub.add_parser("retract"); p.add_argument("--id", required=True)
    p.add_argument("--reason", required=True, help="the audit trail: why the id's scores stop counting")
    p.add_argument("--env", default=None, help="scope tag when the id has records in several envs")
    p.add_argument("--split", default=cfgmod.DEFAULT_SPLIT)
    p.add_argument("--mode", default="proxy", choices=["proxy", "full"])
    p.set_defaults(fn=cmd_retract)
    p = sub.add_parser("board"); p.add_argument("--top", type=int, default=10); p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_board)
    p = sub.add_parser("impls"); p.add_argument("--axis", default=None); p.set_defaults(fn=cmd_impls)
    p = sub.add_parser("apply"); p.add_argument("--id", required=True)
    p.add_argument("--dry", action="store_true", help="print the genome/diff without applying")
    p.set_defaults(fn=cmd_apply)

    args = ap.parse_args(argv)
    root = find_root(args.root)
    try:
        args.fn(root, args)
    except cfgmod.ConfigError as e:
        _fail(str(e), code=2)
    except score.Rejection as e:   # guard/dup from any scoring verb (seed, score, rescore)
        print(json.dumps({"rejected": e.kind, "detail": e.detail}), file=sys.stderr)
        raise SystemExit(4 if e.kind == "guard" else 5)
    except runner.InfraError as e:
        _fail(f"infrastructure failure (not archived — retry): {e}", code=6)
    except (surface.SurfaceError, runner.EvalFailure, ValueError, OSError) as e:
        _fail(str(e), code=1)


if __name__ == "__main__":
    main()
